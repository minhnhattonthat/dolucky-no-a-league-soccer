  "form": "dlg",
  "max": 28,
  "jp": "   「はははは、かっちゃいました。」",
  "en": "   \"Ha ha ha ha, we won.\"",
  "status": "tl",
  "notes": ""
 },
 {
  "id": "quotes_01",
  "addr": "0DED7F",
  "form": "dlg",
  "max": 28,
  "jp": "「これでどうぶつさっかーのちょーてんに\n      たっしたわけっスね。」",
  "en": "\"So that makes us the kings\n  of animal soccer, huh?\"",
  "status": "tl",
  "notes": ""
 },
 {
  "id": "quotes_02",
  "addr": "0DEDA8",
  "form": "dlg",
  "max": 28,
  "jp": "「まぁ、ちょろいもんですわ。むはははは。」",
  "en": "\"Well, easy peasy. Muhaha.\"",
  "status": "tl",
  "notes": ""
 },
 {
  "id": "quotes_03",
  "addr": "0DEDBF",
  "form": "dlg",
  "max": 28,
  "jp": "「・・いやぁ、どうなることかとおもったけど\n どうやらかったみたいスね・・・・・・」",
